{
  "name": "@home-voice-studio/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "tsc --noEmit",
    "tauri:build": "node ../../scripts/run-tauri.mjs build --config src-tauri/tauri.conf.json --bundles app",
    "tauri:build:dmg": "node ../../scripts/run-tauri.mjs build --config src-tauri/tauri.conf.json --bundles dmg",
    "tauri:dev": "node ../../scripts/run-tauri.mjs dev --config src-tauri/tauri.dev.conf.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@home-voice-studio/shared-types": "0.1.0",
    "@home-voice-studio/ui": "0.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
